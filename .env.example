# =============================================================================
# AI Revenue Recovery Agent — Environment Configuration Template
# Copy this file to .env and fill in your API credentials.
# =============================================================================

# --- LLM Provider Configuration ---
# Options: 'gemini', 'groq', or 'mock' (offline deterministic rehearsal mode)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Speech-to-Text (ASR) Provider Configuration ---
# Options: 'sarvam' (live Hinglish ASR), 'mock' (deterministic offline), 'whisper'
ASR_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key_here

# --- Payment Gateway Provider Configuration ---
# Options: 'razorpay' (live test-mode sandbox) or 'mock' (offline deterministic)
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# --- Webhook Security ---
# Webhook secret for HMAC-SHA256 signature verification (X-Razorpay-Signature)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
